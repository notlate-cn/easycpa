# ===== Cloudflare R2 备份配置(必填)=====
CF_ACCOUNT_ID=你的cloudflare账户id
R2_BUCKET=cliproxy-backup
R2_ACCESS_KEY_ID=你的R2凭证Key
R2_SECRET_ACCESS_KEY=你的R2凭证Secret
BACKUP_PASSWORD=你的自定义restic加密密码

# ===== 服务配置(可选)=====
# CLIProxyAPI 镜像,更新时可指定版本如 eceasy/cli-proxy-api:v8.0.4
CPA_IMAGE=eceasy/cli-proxy-api:latest
# 宿主机映射端口
CPA_PORT=8317
# 备份间隔(秒),默认 6 小时
BACKUP_INTERVAL=21600
